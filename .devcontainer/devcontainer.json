{
  "name": "Npm Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "git config --global user.name \"$USER_GIT_NAME\" && git config --global user.email \"$USER_GIT_EMAIL\" && cd server && npm install && cd ../client && npm install",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Default Dark Modern"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "alefragnani.bookmarks",
        "eamodio.gitlens",
        "dbaeumer.vscode-eslint",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense"
      ]
    }
  },
  "remoteEnv": {
    "USER_GIT_NAME": "${localEnv:USER_GIT_NAME}",
    "USER_GIT_EMAIL": "${localEnv:USER_GIT_EMAIL}",
    "USER_GITHUB_TOKEN": "${localEnv:USER_GITHUB_TOKEN}"
  }
}
